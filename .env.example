# Copy to .env and fill in before deploying. Never commit the real .env.

# Sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the SQLite file lives. Use a path outside the app directory in production.
DB_PATH=/var/lib/wordscramble/wordscramble.db

# Optional shared PIN. Leave unset to run the app open (local development only).
ACCESS_PIN=

# Never enable in production: the Werkzeug debugger is remote code execution.
FLASK_DEBUG=0
