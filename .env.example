# Copy to .env and adjust. Never commit the real .env.
#
# Every value below has a working default, so an empty .env is fine for local
# development. The commented lines show what to set when deploying.

# --- Local development -----------------------------------------------------

# Auto-reload and full tracebacks. Must stay 0 in production: the Werkzeug
# debugger allows arbitrary code execution.
FLASK_DEBUG=0

# Local runs use AUTH_MODE=none (the default), which leaves the app open. That
# is only safe on a laptop, so the app refuses to start if it is combined with
# SESSION_COOKIE_SECURE=1 - see _check_deployment() in app.py.


# --- Production ------------------------------------------------------------

# Signs the session cookie (the CSRF token, the active player_id, and flash
# messages - never an identity). Startup fails if this is left at the default
# once the app is deployed. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Authentication. "cloudflare" requires a valid Cloudflare Access assertion on
# every request; "none" (the default) asks for nothing.
# AUTH_MODE=cloudflare

# The <team> in <team>.cloudflareaccess.com, and this application's Audience
# tag. Both are in the Zero Trust dashboard under Access > Applications; the
# Audience tag is on the app's Overview. The audience check is what stops a
# token issued for a different app in the same team from working here.
# CF_ACCESS_TEAM=
# CF_ACCESS_AUD=

# Where the SQLite file lives. Defaults to wordscramble.db beside the code,
# which is fine locally; in production point it somewhere a redeploy cannot
# overwrite.
# DB_PATH=/var/lib/wordscramble/wordscramble.db

# Where uploaded vocabulary lists are written. Same reasoning as DB_PATH: keep
# it outside the app directory so a git pull cannot clobber a parent's lists.
# LISTS_DIR=/var/lib/wordscramble/lists

# Send the session cookie over HTTPS only. Cloudflare terminates TLS, so turn
# this on once the tunnel is up.
# SESSION_COOKIE_SECURE=1

# Player profiles. DEFAULT_PLAYER_NAME is only ever used once, to name the
# profile that a first-time migration assigns all pre-profile history to.
# MAX_PLAYERS caps the picker so it doesn't grow without bound.
# DEFAULT_PLAYER_NAME=Player 1
# MAX_PLAYERS=8
